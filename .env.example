# Server-only secrets. Never use NEXT_PUBLIC_ for these variables.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_USER_ID=your-single-admin-user-uuid
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEW_TOKEN_ENCRYPTION_KEY=
ABUSE_HASH_SECRET=
# Switch only after completing docs/ADMIN_SETUP.md. File mode preserves existing links during migration.
BUSINESS_STORE=file
# Optional absolute path to a privately mounted config file.
# Default: private/clients.json, included in the Next.js server bundle.
# CLIENTS_FILE=
